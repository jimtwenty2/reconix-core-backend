# The built-in RECONIX model. Create it on the local Ollama with:
#   ollama pull qwen2.5:7b-instruct
#   ollama create reconix -f services/ai/models/Modelfile
#
# The base model is a placeholder until the speed check on the demo laptop.
# The prompts are not baked in here: they live in src/reconix_ai/prompts/ and
# are sent with every call, so a prompt change never needs a new model.

FROM qwen2.5:7b-instruct

# Low temperature: plans and analysis should be steady, not creative.
PARAMETER temperature 0.2
PARAMETER num_ctx 8192
