# Reconix settings. Copy this file to .env and fill in the empty values. Never commit .env.

# --- Database -----------------------------------------------------------------------------
# Docker creates the database with these three values, and the API uses them to connect.
RECONIX_DB_NAME=reconix
RECONIX_DB_USER=reconix
RECONIX_DB_PASSWORD=
# Only for commands run outside Docker. Use the same user, password and name as above.
RECONIX_DATABASE_URL=postgresql+psycopg://reconix:CHANGE_ME@127.0.0.1:5432/reconix

# --- Kali tool container ------------------------------------------------------------------
# The image that runs the security tools.
RECONIX_KALI_IMAGE=dannygg02/reconix-kali-container:latest
# Where the API reaches Kali. In Compose it is http://reconix-kali-container:8000/mcp (set by
# deploy/docker-compose.yml). With the API on the host and Kali run by deploy/kali-standalone.yml:
# RECONIX_KALI_MCP_URL=http://127.0.0.1:8096/mcp
# Optional. A token the Kali server checks on every call. Leave empty for none.
# kali-standalone.yml requires it.
RECONIX_MCP_AUTH_TOKEN=
# Required. Signs the one-time token sent with each tool run.
# Create one: python -c "import secrets; print(secrets.token_urlsafe(32))"
RECONIX_JOB_TOKEN_SECRET=

# --- Built-in RECONIX model ---------------------------------------------------------------
# The default AI model, served by the Reconix team (OpenAI-compatible). Needed for AI features.
# Use https (http only for this computer); the address may end in /v1.
RECONIX_MODEL_URL=
# The server's API key, if it needs one.
RECONIX_MODEL_API_KEY=
# The model name on the server.
RECONIX_MODEL_NAME=reconix
# Optional. The longest answer one model call may write, thinking included (1 to 128000;
# empty means 128000). Cloud models are lowered to their own known limit automatically;
# lower this if a self-hosted server refuses the request for asking too much.
RECONIX_MAX_OUTPUT_TOKENS=
# Optional. How many tokens the Reconix model holds, prompt and answer together (empty means
# 64000). Each call's answer limit is lowered to fit it. Set it when the server's window changes.
RECONIX_CONTEXT_WINDOW=

# --- Encryption ---------------------------------------------------------------------------
# Required. Encrypts the AI provider API keys you save and the hidden values behind masked
# evidence. If it is lost or changed, saved keys must be entered again and hidden values can
# no longer be shown.
# Create one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RECONIX_PROVIDER_ENCRYPTION_KEY=

# --- Files --------------------------------------------------------------------------------
# Keep these folders inside data/: the API container only sees that folder.
# Where reports (PDF, DOCX, JSON) are saved.
RECONIX_REPORTS_DIR=data/reports
# Where code from the VS Code extension is saved, one folder per session. Kali reads data/code,
# so change both together. With deploy/kali-standalone.yml (API on the host) use an ABSOLUTE
# path, because that file mounts it from the Kali repo's folder.
RECONIX_CODE_DIR=data/code
# Largest code upload in MB, packed and unpacked.
RECONIX_MAX_UPLOAD_MB=100
# Folders (comma-separated) searched 4 levels deep for a clone of a GitHub repo before
# POST /sessions/{id}/code/clone runs git clone. Its working tree is copied, never pulled.
# Default: none
RECONIX_LOCAL_REPO_ROOTS=
# Where the hidden values behind masked evidence are kept, encrypted, until a person approves
# showing one.
RECONIX_VAULT_DIR=data/vault
# Knowledge documents uploaded and waiting to be ingested (masked passages, encrypted)
RECONIX_KNOWLEDGE_PENDING_DIR=data/knowledge-pending

# --- Rate limit ---------------------------------------------------------------------------
# Requests per session token per minute; after that the API answers 429.
RECONIX_RATE_LIMIT_PER_MINUTE=600
# Sign-ins per minute (POST /sessions and /sessions/web-sign-in).
RECONIX_SIGN_IN_LIMIT_PER_MINUTE=20
