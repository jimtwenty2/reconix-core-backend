# Copy to .env and fill in. Never commit .env.

# Database (Docker Compose and the API)
RECONIX_DB_NAME=reconix
RECONIX_DB_USER=reconix
RECONIX_DB_PASSWORD=
RECONIX_DATABASE_URL=postgresql+psycopg://reconix:CHANGE_ME@127.0.0.1:5432/reconix

# Kali MCP container, run standalone (deploy/kali-standalone.yml, see deploy/AGENTS.md).
RECONIX_KALI_MCP_URL=http://127.0.0.1:8096/mcp
# kali-standalone.yml pins the MCP port to 127.0.0.1:8096 (the Kali repo's own HOST_PORT
# is not used), so keep RECONIX_KALI_MCP_URL on that port.
# Old offline path only (the kali-mcp service in deploy/docker-compose.yml and the dev
# relay in deploy/docker-compose.dev.yml, which use http://127.0.0.1:8765/mcp).
RECONIX_KALI_IMAGE=ghcr.io/14th-generation-advanced-course/reconix-kali-mcp:dev
RECONIX_MCP_PORT=8765
# The bearer token of the Kali MCP server (its KALI_MCP_AUTH_TOKEN).
RECONIX_MCP_ACCESS_KEY=
# Shared with the Kali container to sign one-time job tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RECONIX_JOB_TOKEN_SECRET=

# Encrypts AI provider API keys. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RECONIX_FERNET_KEY=

# Where report files (PDF, DOCX, JSON) are saved. Default: data/reports
RECONIX_REPORTS_DIR=data/reports

# Source code to scan, one folder per session (uploads, clones, copied folders). Kali
# mounts it read-only at /workspace/code. Use an ABSOLUTE path: deploy/kali-standalone.yml
# mounts it from the Kali repo's folder, so a relative one points somewhere else.
# Default: data/code (relative to where the API starts)
RECONIX_CODE_DIR=/absolute/path/to/reconix-core-backend/data/code
# Largest code upload in MB, packed and unpacked. Default: 100
RECONIX_MAX_UPLOAD_MB=100
# Folders (comma-separated) searched 4 levels deep for a clone of a GitHub repo before
# POST /sessions/{id}/code/clone runs git clone. Its working tree is copied, never pulled.
# Default: none
RECONIX_LOCAL_REPO_ROOTS=
