# Reconix settings. Copy this file to .env and fill in the empty values. Never commit .env.

# --- Database -----------------------------------------------------------------------------
# Docker creates the database with these three values, and the API uses them to connect.
RECONIX_DB_NAME=reconix
RECONIX_DB_USER=reconix
RECONIX_DB_PASSWORD=
# Only for commands run outside Docker. Use the same user, password and name as above.
RECONIX_DATABASE_URL=postgresql+psycopg://reconix:CHANGE_ME@127.0.0.1:5432/reconix

# --- Kali tool container ------------------------------------------------------------------
# The image that runs the security tools.
RECONIX_KALI_IMAGE=dannygg02/reconix-kali-container:latest
# Optional. A token the Kali server checks on every call. Leave empty for none.
RECONIX_MCP_AUTH_TOKEN=
# Required. Signs the one-time token sent with each tool run.
# Create one: python -c "import secrets; print(secrets.token_urlsafe(32))"
RECONIX_JOB_TOKEN_SECRET=

# --- Built-in RECONIX model ---------------------------------------------------------------
# The default AI model, served by the Reconix team (OpenAI-compatible). Needed for AI features.
# Use https (http only for this computer); the address may end in /v1.
RECONIX_MODEL_URL=
# The server's API key, if it needs one.
RECONIX_MODEL_API_KEY=
# The model name on the server.
RECONIX_MODEL_NAME=reconix

# --- Encryption ---------------------------------------------------------------------------
# Required. Encrypts the AI provider API keys you save. If it is lost or changed, saved keys
# must be entered again.
# Create one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RECONIX_PROVIDER_ENCRYPTION_KEY=

# --- Files --------------------------------------------------------------------------------
# Keep both folders inside data/: the API container only sees that folder.
# Where reports (PDF, DOCX, JSON) are saved.
RECONIX_REPORTS_DIR=data/reports
# Where code from the VS Code extension is saved. Kali reads data/code, so change both together.
RECONIX_CODE_DIR=data/code
# Largest code upload in MB, packed and unpacked.
RECONIX_MAX_UPLOAD_MB=100
