# Copy to .env and fill in. Never commit .env.

# Database (Docker Compose and the API)
RECONIX_DB_NAME=reconix
RECONIX_DB_USER=reconix
RECONIX_DB_PASSWORD=
RECONIX_DATABASE_URL=postgresql+psycopg://reconix:CHANGE_ME@127.0.0.1:5432/reconix

# Kali MCP container
RECONIX_KALI_IMAGE=ghcr.io/14th-generation-advanced-course/reconix-kali-mcp:dev
RECONIX_KALI_MCP_URL=http://127.0.0.1:8765/mcp
# Dev only (deploy/docker-compose.dev.yml): the host port of the Kali MCP relay.
# If 8765 is taken on your computer, change it here and in RECONIX_KALI_MCP_URL.
RECONIX_MCP_PORT=8765
RECONIX_MCP_ACCESS_KEY=
# Shared with the Kali container to sign one-time job tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RECONIX_JOB_TOKEN_SECRET=

# Encrypts AI provider API keys. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RECONIX_FERNET_KEY=

# Where report files (PDF, DOCX, JSON) are saved. Default: data/reports
RECONIX_REPORTS_DIR=data/reports

# Source code sent by the VS Code extension, one folder per session. The kali-mcp service
# in deploy/docker-compose.yml mounts ../data/code read-only at /workspace/code; if you
# change this, change that volume too. Default: data/code
RECONIX_CODE_DIR=data/code
# Largest code upload in MB, packed and unpacked. Default: 100
RECONIX_MAX_UPLOAD_MB=100

# Requests per session token per minute, then 429 TOO_MANY_REQUESTS. Signing in
# (POST /sessions, POST /sessions/web-sign-in) has its own limit. Defaults: 600 and 20
RECONIX_RATE_LIMIT_PER_MINUTE=600
RECONIX_SIGN_IN_LIMIT_PER_MINUTE=20
